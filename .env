# Two different URLs. No trailing slash on either. On Vercel, set both in
# Project Settings > Environment Variables instead (these are just local defaults).

# This terminal site's OWN public URL. Used for the link-preview tags in index.html.
VITE_SITE_URL=https://example.com

# Your MAIN portfolio site (the normal website). `exit`, the no-JavaScript message
# and the crash screen send visitors here.
VITE_MAIN_SITE_URL=https://example.com
